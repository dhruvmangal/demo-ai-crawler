# Copy to .env for local dev. Never commit a real .env / .env.production file.

# --- Core ---
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
DATABASE_URL=postgresql://crawler_user:crawler_password@localhost:5432/crawler_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crawler_neo4j_password
RECORDINGS_DIR=./recordings
CRAWL_TTL_HOURS=24

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# --- OAuth (leave blank locally if you don't have real credentials -- those login methods just won't work) ---
GOOGLE_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Email (leave blank to fall back to console-logging verification/reset links in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com

# --- App URLs (used to build links in emails) ---
APP_BASE_URL=http://localhost:3000
ADMIN_APP_BASE_URL=http://localhost:3001

# --- Superadmin bootstrap (one-time seed; rotate the password after first login) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-immediately

# --- SSRF guard ---
# Set to "true" only in local/dev to allow crawling localhost / private-network targets
# (e.g. the built-in mock-crm-server). Must stay unset/false in production.
ALLOW_PRIVATE_CRAWL_TARGETS=false
