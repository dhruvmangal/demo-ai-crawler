{
  "name": "website-discovery-knowledge-graph-builder",
  "version": "1.0.0",
  "description": "Production-ready website discovery and knowledge graph builder service",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/server.js",
    "dev": "tsx watch src/api/server.ts",
    "worker:crawl": "npm run build && node dist/workers/crawl-worker.js",
    "worker:record": "npm run build && node dist/workers/workflow-agent-worker.js",
    "test:mock": "npm run build && node dist/test-crawler.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.21.0",
    "pg": "^8.12.0",
    "playwright": "1.62.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
